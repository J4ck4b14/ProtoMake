    {
      "id": "078e7248-6e1e-445e-994c-524bf92f7496",
      "path": "Assets/Scripts/MovingPlatform.ts",
      "kind": "text",
      "mime": "text/typescript",
      "data": "import type { ScriptContext } from '@protomake/scripting';\nexport const fields = {\n  speed: { type: 'number', default: 1.2 },\n  distance: { type: 'number', default: 90 },\n} as const;\nexport default class MovingPlatform {\n  speed = 1.2;\n  distance = 90;\n  private origin: readonly [number, number] = [0, 0];\n  start(ctx: ScriptContext) {\n    this.origin = ctx.position();\n  }\n  fixedUpdate(ctx: ScriptContext) {\n    ctx.setPosition(\n      this.origin[0] + Math.sin(ctx.elapsed * this.speed) * this.distance,\n      this.origin[1],\n    );\n  }\n}\n",
      "width": 0,
      "height": 0
    },
    {
      "id": "dba98b58-fab0-4432-a612-1c4c25d6f3cd",
      "path": "Assets/Scripts/PlayerController.ts",
      "kind": "text",
      "mime": "text/typescript",
      "data": "import type { ScriptContext } from '@protomake/scripting';\nexport const fields = {\n  speed: { type: 'number', default: 220 },\n  jumpSpeed: { type: 'number', default: 440 },\n} as const;\nexport default class PlayerController {\n  speed = 220;\n  jumpSpeed = 440;\n  private jumpReady = true;\n  fixedUpdate(ctx: ScriptContext) {\n    const position = ctx.position();\n    const move = ctx.input.getVector('Move');\n    ctx.setParameter('moving', Math.abs(move[0]) > 0.1);\n    let vy = ctx.physics.velocity(ctx.entity)[1];\n    if (!ctx.input.isPressed('Jump')) this.jumpReady = true;\n    const ground = ctx.physics.raycast(position, [0, 1], 23, ctx.entity);\n    if (ctx.input.isPressed('Jump') && this.jumpReady && ground && vy >= -1) {\n      vy = -this.jumpSpeed;\n      this.jumpReady = false;\n      ctx.playAudio();\n    }\n    ctx.physics.setVelocity(ctx.entity, move[0] * this.speed, vy);\n    if (position[1] > 600) {\n      ctx.setPosition(-250, 40);\n      ctx.physics.setVelocity(ctx.entity, 0, 0);\n      ctx.log('Respawned');\n    }\n  }\n}\n",
      "width": 0,
      "height": 0
    },
    {
      "id": "fc8e3582-239c-4c7e-97b3-1991d6001735",
      "path": "Assets/Scripts/Pulse.ts",
      "kind": "text",
      "mime": "text/typescript",
      "data": "import type { ScriptContext } from '@protomake/scripting';\nexport const fields = {\n  speed: { type: 'number', default: 2 },\n  minimumOpacity: { type: 'number', default: 0.25 },\n} as const;\nexport default class Pulse {\n  speed = 2;\n  minimumOpacity = 0.25;\n  update(ctx: ScriptContext) {\n    const sprite = ctx.get<Record<string, unknown>>('protomake.sprite');\n    if (!sprite) return;\n    const wave = (Math.sin(ctx.elapsed * this.speed) + 1) / 2;\n    ctx.set('protomake.sprite', {\n      ...sprite,\n      opacity: this.minimumOpacity + (1 - this.minimumOpacity) * wave,\n    });\n  }\n}\n",
      "width": 0,
      "height": 0
    },
    {
      "id": "796add1a-8b24-4db3-a399-3c46b5595c8d",
      "path": "Assets/Scripts/TriggerReaction.ts",
      "kind": "text",
      "mime": "text/typescript",
      "data": "import type { ScriptContext } from '@protomake/scripting';\nexport const fields = {\n  target: { type: 'entity', default: '' },\n  color: { type: 'color', default: '#8bffb3' },\n} as const;\nexport default class TriggerReaction {\n  target = '';\n  color = '#8bffb3';\n  onTriggerEnter(ctx: ScriptContext) {\n    const id = this.target || ctx.entity;\n    const sprite = ctx.get<Record<string, unknown>>('protomake.sprite', id);\n    if (sprite) ctx.set('protomake.sprite', { ...sprite, tint: this.color }, id);\n    ctx.log('Trigger entered: target tint changed in runtime only.');\n  }\n  onTriggerExit(ctx: ScriptContext) {\n    ctx.log('Trigger exited.');\n  }\n}\n",
      "width": 0,
      "height": 0
    },
